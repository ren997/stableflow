# StableFlow Docker deployment environment template
# Copy this file to `.env` before running `docker compose up -d --build`

# Public access
FRONTEND_PORT=80
PUBLIC_BASE_URL=http://your-server-ip-or-domain
CORS_ALLOWED_ORIGINS=http://your-server-ip-or-domain

# Backend profile and security
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-a-long-random-secret
JWT_TOKEN_TTL=12h

# PostgreSQL
DB_URL=jdbc:postgresql://your-postgres-host:5432/stableflow
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

# Solana
SOLANA_NETWORK=DEVNET
SOLANA_RPC_URL=
SOLANA_USDC_MINT=
SOLANA_CONNECT_TIMEOUT=3s
SOLANA_READ_TIMEOUT=10s
SOLANA_RETRY_MAX_ATTEMPTS=3
SOLANA_RETRY_DELAY=500ms

# Scheduled jobs
SOLANA_SCAN_ENABLED=true
SOLANA_SCAN_BATCH_SIZE=50
SOLANA_SCAN_FIXED_DELAY_MS=30000
SOLANA_SCAN_INITIAL_DELAY_MS=10000
SOLANA_SCAN_LOCK_ENABLED=true
SOLANA_SCAN_LOCK_KEY=stableflow:job:payment-scan:lock
SOLANA_SCAN_LOCK_TTL=5m

INVOICE_EXPIRE_JOB_ENABLED=true
INVOICE_EXPIRE_JOB_FIXED_DELAY_MS=30000
INVOICE_EXPIRE_JOB_INITIAL_DELAY_MS=12000

PAYMENT_VERIFY_ENABLED=true
PAYMENT_VERIFY_BATCH_SIZE=50
PAYMENT_VERIFY_FIXED_DELAY_MS=30000
PAYMENT_VERIFY_INITIAL_DELAY_MS=15000

RECONCILIATION_JOB_ENABLED=true
RECONCILIATION_JOB_BATCH_SIZE=50
RECONCILIATION_JOB_FIXED_DELAY_MS=30000
RECONCILIATION_JOB_INITIAL_DELAY_MS=20000

OUTBOX_JOB_ENABLED=true
OUTBOX_JOB_BATCH_SIZE=50
OUTBOX_JOB_FIXED_DELAY_MS=30000
OUTBOX_JOB_INITIAL_DELAY_MS=25000
OUTBOX_JOB_LOCK_ENABLED=true
OUTBOX_JOB_LOCK_KEY=stableflow:job:outbox-dispatch:lock
OUTBOX_JOB_LOCK_TTL=5m
OUTBOX_JOB_RETRY_DELAY=1m

# Merchant ownership
MERCHANT_OWNERSHIP_CHALLENGE_TTL=10m

# Reserved for later
AGENT_API_KEY=replace-me
